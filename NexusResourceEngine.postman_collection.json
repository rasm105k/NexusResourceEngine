{
  "info": {
    "name": "NexusResourceEngine",
    "description": "Full API collection for NexusResource Engine. Flow: Seed demo data (autofills IDs) → Login (autosaves JWT) → Explore states/transitions → Create resources → Book.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "localhost:5279" },
    { "key": "authToken", "value": "" },
    { "key": "demoEmail", "value": "demo@example.com" },
    { "key": "demoPassword", "value": "Demo@123" },
    { "key": "stateAvailable", "value": "" },
    { "key": "stateBooked", "value": "" },
    { "key": "stateOccupied", "value": "" },
    { "key": "stateCleaning", "value": "" },
    { "key": "stateMaintenance", "value": "" },
    { "key": "resourceId", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Seed Demo Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', json.token);",
                  "  pm.collectionVariables.set('stateAvailable', json.states.available);",
                  "  pm.collectionVariables.set('stateBooked', json.states.booked);",
                  "  pm.collectionVariables.set('stateOccupied', json.states.occupied);",
                  "  pm.collectionVariables.set('stateCleaning', json.states.cleaning);",
                  "  pm.collectionVariables.set('stateMaintenance', json.states.maintenance);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://{{baseUrl}}/dev/seed"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationName\": \"My Company\",\n  \"username\": \"admin\",\n  \"email\": \"admin@company.com\",\n  \"password\": \"P@ssw0rd123\"\n}"
            },
            "url": "http://{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "http://{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "States",
      "item": [
        {
          "name": "Get All States",
          "request": {
            "method": "GET",
            "url": "http://{{baseUrl}}/states"
          }
        },
        {
          "name": "Create State",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"In Transit\",\n  \"isBookable\": false,\n  \"colorCode\": \"#17a2b8\",\n  \"sortOrder\": 6\n}"
            },
            "url": "http://{{baseUrl}}/states"
          }
        }
      ]
    },
    {
      "name": "Transitions",
      "item": [
        {
          "name": "Create Transition",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromStateId\": \"{{stateAvailable}}\",\n  \"toStateId\": \"{{stateMaintenance}}\",\n  \"requiredRole\": \"Admin\"\n}"
            },
            "url": "http://{{baseUrl}}/transitions"
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "Get All Resources",
          "request": {
            "method": "GET",
            "url": "http://{{baseUrl}}/resources"
          }
        },
        {
          "name": "Get Resources by State",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://{{baseUrl}}/resources?stateId={{stateAvailable}}",
              "query": [{ "key": "stateId", "value": "{{stateAvailable}}" }]
            }
          }
        },
        {
          "name": "Create Resource",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('resourceId', json.resourceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Conference Room A\",\n  \"description\": \"Ground floor meeting room with 4K projector\",\n  \"currentStateId\": \"{{stateAvailable}}\",\n  \"latitude\": 51.5074,\n  \"longitude\": -0.1278,\n  \"metadata\": null\n}"
            },
            "url": "http://{{baseUrl}}/resources"
          }
        },
        {
          "name": "Update Resource State",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStateId\": \"{{stateMaintenance}}\"\n}"
            },
            "url": "http://{{baseUrl}}/resources/{{resourceId}}/state"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://{{baseUrl}}/resources/{{resourceId}}/availability?start=2026-05-08T09:00:00Z&end=2026-05-08T17:00:00Z",
              "query": [
                { "key": "start", "value": "2026-05-08T09:00:00Z" },
                { "key": "end", "value": "2026-05-08T17:00:00Z" }
              ]
            }
          }
        },
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('bookingId', json.bookingId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resourceId}}\",\n  \"startTime\": \"2026-05-08T09:00:00Z\",\n  \"endTime\": \"2026-05-08T10:00:00Z\"\n}"
            },
            "url": "http://{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": "http://{{baseUrl}}/bookings/{{bookingId}}/status"
          }
        }
      ]
    }
  ]
}
